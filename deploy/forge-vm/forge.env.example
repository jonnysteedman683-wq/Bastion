# Forge VM environment: names and non-secret pins only. Never put a secret value in this file.
# forge-setup.sh builds /etc/forge/forge.env (mode 0600, owner root) from it on the VM.

# --- Secrets: listed by name, always empty here ---
# One-off Tailscale auth key. Typed into forge-setup.sh (hidden); used once and never stored.
TS_AUTHKEY=
# Generated on the VM by forge-setup.sh; they never leave it. Only their hashes are shown.
FORGE_PG_PASSWORD=
UNISYNC_VORTEX_TOKEN=
# Assembled on the VM from FORGE_PG_USER, FORGE_PG_PASSWORD and FORGE_PG_HOST (Supabase session pooler).
VORTEX_STORE_URL=

# --- Non-secret pins ---
# Vortex-MCP commit the VM runs. Today: main before apikey mode.
# Must be bumped to the apikey merge commit before the VM is built (the owner merges Vortex-MCP PRs).
VORTEX_REF=b502bc0
VORTEX_SCHEMA=forge
VORTEX_AUTH_MODE=apikey
VORTEX_AGENT_IDS=claude-1,hermes-1,hermes-2,sebastian-1,lestinxor-1,jules-1
VORTEX_HOST=127.0.0.1
VORTEX_PORT=8000
FORGE_PG_USER=vortex_app.dcjqwnapxgocitvntzzm
UNISYNC_GATEWAY_URL=https://dcjqwnapxgocitvntzzm.supabase.co/functions/v1/unisync

# Not listed on purpose: forge-setup.sh asks for FORGE_PG_HOST (the Supabase "Session pooler" host, not secret)
# and derives the public URL, allowed hosts and allowed origins from the VM's Tailscale Funnel name.
